{
  "name": "lago-openapi",
  "version": "1.9.0",
  "description": "Open API specification for Lago project.",
  "main": "index.js",
  "scripts": {
    "build": "redocly bundle",
    "build:v1": "redocly bundle v1",
    "build:v2": "redocly bundle v2",
    "lint": "redocly lint && spectral lint openapi.yaml openapi-v2.yaml",
    "test": "npm run build && npm run lint",
    "clean": "rm -r _build",
    "preview:swagger": "npm run build && sh scripts/preview-swagger.sh",
    "preview:redocly": "redocly preview --project-dir=. --port 8080"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlago/lago-openapi.git"
  },
  "license": "AGPLv3",
  "bugs": {
    "url": "https://github.com/getlago/lago-openapi/issues"
  },
  "homepage": "https://github.com/getlago/lago-openapi#README",
  "dependencies": {
    "@redocly/cli": "^2.15.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "inflection": "^3.0.2"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
